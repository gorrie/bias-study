# Copy to .env and fill in your own values. NEVER commit the real .env.
# Credential resolution order: OPENROUTER_API_KEY in the environment first,
# then a repo-root .env (this file, copied and filled). Get a key at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OWN_KEY

# Hugging Face token — only needed to download gated base models (weight rung).
HF_TOKEN=hf_REPLACE_WITH_YOUR_OWN_TOKEN

# Local token for the optional G0DM0D3 pipeline server (pick any string).
GODMODE_API_KEY=pick-any-local-token

# Where downloaded base models and abliterated outputs live (weight rung only).
# Relative paths resolve from the repo root; absolute paths are fine too.
MODELS_DIR=./models
ABLIT_OUT=./abliteration-output
