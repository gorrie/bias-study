# Copy to .env and fill in your own values. NEVER commit the real .env.
#
# Credential resolution order: process environment first, then repo-root .env
# (this file, copied and filled). Scripts that need a key fail loudly if it is
# unresolvable; nothing silently degrades to "no key, score blank."
#
# Get an OpenRouter key at https://openrouter.ai/keys

# --- Prompt rung (required for run_study.py + score.py + the four API judges) ---
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_OWN_KEY

# --- Weight rung (only needed when running abliteration / dl_model.py) ---
# Hugging Face token for downloading gated base models (Llama, Gemma, etc.)
HF_TOKEN=hf_REPLACE_WITH_YOUR_OWN_TOKEN

# Where downloaded base models and abliterated outputs live (weight rung only).
# Relative paths resolve from the repo root; absolute paths are fine too.
MODELS_DIR=./models
ABLIT_OUT=./abliteration-output

# --- Abliterated open-weight judge (Method 2, in-process MLX or vLLM endpoint) ---
# Only needed when Method 2 is run against a remote serving endpoint. The
# in-process MLX path (Apple Silicon, score_inproc_gemma.py) does NOT need any
# of these — it loads the converted weights directly from disk.
ABLITERATED_ENDPOINT=http://localhost:8000/v1
ABLITERATED_MODEL=gemma-2-9b-it-abliterated
ABLITERATED_API_KEY=

# --- G0DM0D3 elicitation pipeline (Pipeline Rung, optional) ---
# Only needed for the pipeline rung (Method 3 / WP2). Local server endpoint;
# the API key is a pick-any-local-token shared between the server and the
# scoring script.
G0DM0D3_ENDPOINT=http://localhost:8001/v1
G0DM0D3_API_KEY=pick-any-local-token
